{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/thank-you",
      "destination": "https://thankyoupage-nu.vercel.app"
    },
    {
      "source": "/thank-you/(.*)",
      "destination": "https://thankyoupage-nu.vercel.app/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}